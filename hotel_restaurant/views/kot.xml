<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Template for Kitchen Order Ticket -->
    <template id="report_hotel_order_kot">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt-3">Kitchen Order Ticket</h2>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Order Number</th>
                                    <th>Served By</th>
                                    <th>Room Number</th>
                                    <th>Tables</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-nowrap">
                                        <span t-field="o.o_date" />
                                    </td>
                                    <td>
                                        <span t-field="o.order_no" />
                                    </td>
                                    <td>
                                        <span t-field="o.waiter_id" />
                                    </td>
                                    <td>
                                        <span t-field="o.room_id" />
                                    </td>
                                    <td>
                                        <span
                                            t-out="', '.join(o.table_nos_ids.mapped('name'))"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h3>Food Item List</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Food Item</th>
                                    <th class="text-end">Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.order_list_ids" t-as="line">
                                    <td>
                                        <span t-field="line.menucard_id" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.item_qty" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
