<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Template for Hotel Reservation -->
    <template id="report_room_reservation_qweb">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-set="title">Reservation List</t>
                    <t t-call="hotel_reservation.report_reservation_header" />
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Guest Name</th>
                                <th>Check-In Date</th>
                                <th>Check-Out Date</th>
                                <th>Room Details</th>
                                <th>Room No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="reservations" t-as="info">
                                <td>
                                    <span t-field="info.reservation_no" />
                                </td>
                                <td>
                                    <span t-field="info.partner_id" />
                                </td>
                                <td class="text-nowrap">
                                    <span t-field="info.checkin" />
                                </td>
                                <td class="text-nowrap">
                                    <span t-field="info.checkout" />
                                </td>
                                <t
                                    t-call="hotel_reservation.report_reservation_rooms"
                                />
                            </tr>
                            <tr t-if="not reservations">
                                <td colspan="6" class="text-center text-muted">
                                    No reservation in this period.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
