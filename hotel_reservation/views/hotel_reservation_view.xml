<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ======== Reservation ======== -->
    <!-- Form view of hotel reservation -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button
                        name="confirmed_reservation"
                        string="Confirm"
                        invisible="state != 'draft'"
                        class="btn-primary"
                        type="object"
                    />
                    <button
                        name="create_folio"
                        string="Create Folio"
                        invisible="state != 'confirm'"
                        class="btn-primary"
                        type="object"
                    />
                    <button
                        name="action_send_reservation_mail"
                        type="object"
                        string="Send Reservation Email"
                        invisible="state != 'confirm'"
                    />
                    <button
                        name="cancel_reservation"
                        string="Cancel Reservation"
                        invisible="state not in ['draft', 'confirm']"
                        type="object"
                    />
                    <button
                        name="set_to_draft_reservation"
                        string="Set to Draft"
                        invisible="state != 'cancel'"
                        type="object"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="open_folio_view"
                            type="object"
                            icon="description"
                            class="oe_stat_button"
                            invisible="no_of_folio == 0"
                        >
                            <field
                                name="no_of_folio"
                                widget="statinfo"
                                string="Folio"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reservation_no" string="Reservation No" />
                        <h1>
                            <field name="reservation_no" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_order" />
                            <field name="company_id" />
                        </group>
                    </group>
                    <separator string="Booking Details" />
                    <group>
                        <group>
                            <field
                                name="partner_id"
                                readonly="state != 'draft'"
                                context="{'default_customer_rank': 1}"
                            />
                            <field
                                name="partner_order_id"
                                readonly="state != 'draft'"
                                domain="[('parent_id','=',partner_id)]"
                            />
                            <field
                                name="partner_invoice_id"
                                domain="[('parent_id','=',partner_id)]"
                            />
                            <field
                                name="partner_shipping_id"
                                readonly="state != 'draft'"
                                domain="[('parent_id','=',partner_id)]"
                            />
                        </group>
                        <group>
                            <field readonly="state != 'draft'" name="pricelist_id" />
                            <field
                                name="checkin"
                                string="Booking Date"
                                readonly="state != 'draft'"
                                widget="daterange"
                                options="{'end_date_field': 'checkout'}"
                            />
                            <field
                                name="checkout"
                                readonly="state != 'draft'"
                                invisible="1"
                            />
                            <field name="total_guest" />
                            <field name="adults" />
                            <field name="children" />
                        </group>
                    </group>
                    <notebook>
                        <page name="reservation_line" string="Reservation Line">
                            <field name="reservation_line" readonly="state != 'draft'">
                                <!-- hotel_website adds the room type before reserve -->
                                <list>
                                    <field
                                        name="available_room_ids"
                                        column_invisible="1"
                                    />
                                    <field
                                        name="reserve"
                                        string="Rooms"
                                        widget="many2many_tags"
                                    />
                                </list>
                                <form string="Reservation Line">
                                    <group>
                                        <field name="categ_id" />
                                        <field
                                            name="available_room_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="reserve"
                                            string="Room Number"
                                            widget="many2many_tags"
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="guests" string="Guests">
                            <field
                                name="guest_ids"
                                nolabel="1"
                                readonly="state != 'draft'"
                            >
                                <list editable="bottom">
                                    <field name="name" string="Guest Name" />
                                    <field name="guest_type" />
                                    <field name="phone" />
                                    <field name="email" />
                                </list>
                            </field>
                            <p class="text-muted">
                                The main guest is counted automatically - list
                                only the people staying with them. Each guest is
                                saved as a child contact of the main guest.
                            </p>
                        </page>
                        <page name="history" string="History">
                            <field name="folio_id" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!-- List view of hotel reservation -->
    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list
                decoration-bf="state == 'draft'"
                decoration-info="state == 'done'"
                decoration-muted="state=='cancel'"
            >
                <field name="reservation_no" />
                <field name="partner_id" />
                <field name="checkin" />
                <field name="checkout" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirm'"
                    decoration-muted="state in ['done', 'cancel']"
                />
            </list>
        </field>
    </record>
    <!-- Search view of hotel reservation -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservation">
                <field name="partner_id" />
                <field name="reservation_no" />
                <field name="checkin" />
                <field name="checkout" />
                <field name="state" />
                <filter
                    name="current_reservations"
                    string="Current Reservations"
                    domain="[('checkout','&gt;=',datetime.datetime.now().replace(hour=0, minute=0, second=0)),('checkin','&lt;=',datetime.datetime.now().replace(hour=23, minute=59, second=59))]"
                    help="Current Reservations"
                />
                <separator />
                <filter name="draft" domain="[('state','=','draft')]" string="Draft" />
                <filter
                    name="confirm"
                    domain="[('state','=','confirm')]"
                    string="Confirm"
                />
                <filter
                    name="cancel"
                    domain="[('state','=','cancel')]"
                    string="Cancel"
                />
                <filter name="done" domain="[('state','=','done')]" string="Done" />
                <group>
                    <filter
                        name="partner_id"
                        string="Guest Name"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="order_by_month"
                        string="Order By Month"
                        context="{'group_by': 'date_order'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!-- Graph view of hotel reservation -->
    <record id="view_hotel_reservation_graph" model="ir.ui.view">
        <field name="name">hotel.reservation.graph</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <graph string="Reservation" type="pie">
                <field name="state" />
            </graph>
        </field>
    </record>
    <!--     Calendar view of hotel reservation -->
    <record id="hotel_calendar_view" model="ir.ui.view">
        <field name="name">Room Reservation</field>
        <field name="model">hotel.reservation</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <calendar
                string="Current Reservation"
                date_start="checkin"
                date_stop="checkout"
                color="partner_id"
            >
                <field name="partner_id" />
            </calendar>
        </field>
    </record>
    <!-- Action of hotel reservation -->
    <record id="action_hotel_reservation_tree_all" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form,calendar,graph</field>
    </record>
    <menuitem
        id="menu_hotel_reservation"
        name="Reservations"
        parent="vertical_hotel.hotel_management_menu"
        sequence="1"
    />
    <menuitem
        id="menu_action_hotel_reservation_tree_all"
        name="Reservations"
        action="action_hotel_reservation_tree_all"
        parent="menu_hotel_reservation"
        sequence="3"
    />
    <record id="view_hotel_room_form_inherited" model="ir.ui.view">
        <field name="name">view.hotel.room.form.inherited</field>
        <field name="model">hotel.room</field>
        <field name="inherit_id" ref="vertical_hotel.view_hotel_room_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information_hotel_room']" position="after">
                <page name="room_reservation" string="Room Reservation">
                    <field name="room_reservation_line_ids">
                        <list>
                            <field name="room_id" />
                            <field name="check_in" />
                            <field name="check_out" />
                            <field name="state" />
                            <field name="reservation_id" />
                            <field name="status" />
                        </list>
                        <form string="Room line">
                            <group>
                                <group>
                                    <field name="room_id" />
                                    <field name="reservation_id" />
                                    <field name="state" />
                                    <field name="status" />
                                </group>
                                <group>
                                    <field name="check_in" />
                                    <field name="check_out" />
                                </group>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_hotel_folio_form_inherited" model="ir.ui.view">
        <field name="name">hotel.folio.form.inherited</field>
        <field name="model">hotel.folio</field>
        <field name="inherit_id" ref="vertical_hotel.view_hotel_folio_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="reservation_id" readonly="1" />
            </field>
        </field>
    </record>
    <record id="view_hotel_folio_tree_inherited" model="ir.ui.view">
        <field name="name">hotel.folio.list.inherited</field>
        <field name="model">hotel.folio</field>
        <field name="inherit_id" ref="vertical_hotel.view_hotel_folio_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="reservation_id" />
            </field>
        </field>
    </record>
    <record id="view_hotel_folio1_search_inherited" model="ir.ui.view">
        <field name="name">hotel.folio.search.inherited</field>
        <field name="model">hotel.folio</field>
        <field name="inherit_id" ref="vertical_hotel.view_hotel_folio_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="reservation_id" />
            </field>
        </field>
    </record>
    <!-- Form view of room reservation summary -->
    <record id="room_reservation_summary_form_view" model="ir.ui.view">
        <field name="name">room.reservation.summary.form</field>
        <field name="model">room.reservation.summary</field>
        <field name="arch" type="xml">
            <form string="Reservation Summary">
                <sheet>
                    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-3">
                        <label
                            for="date_from"
                            string="Summary Period"
                            class="fw-bold"
                        />
                        <field name="date_from" class="oe_inline" />
                        <span>to</span>
                        <field name="date_to" class="oe_inline" />
                        <span class="ms-auto small text-muted">
                            <span
                                class="badge o_room_summary_free text-body"
                            >Free</span>
                            <span
                                class="badge o_room_summary_reserved text-body"
                            >Reserved</span>
                            <span
                                class="badge o_room_summary_folio text-body"
                            >Folio</span>
                        </span>
                    </div>
                    <field
                        name="summary_data"
                        widget="room_reservation_summary"
                        nolabel="1"
                    />
                </sheet>
            </form>
        </field>
    </record>
    <!-- Form view of quick room reservation -->
    <record id="quick_room_reservation_form_view" model="ir.ui.view">
        <field name="name">quick.room.reservation.form</field>
        <field name="model">quick.room.reservation</field>
        <field name="arch" type="xml">
            <form string="Quick Reservation">
                <group>
                    <group>
                        <field name="room_id" readonly="1" force_save="1" />
                        <field name="check_in" />
                        <field name="check_out" />
                        <field name="adults" />
                    </group>
                    <group>
                        <field name="partner_id" />
                        <field name="pricelist_id" />
                        <field name="company_id" invisible="1" />
                        <field name="partner_invoice_id" />
                        <field name="partner_order_id" />
                        <field name="partner_shipping_id" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Save"
                        name="room_reserve"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Discard"
                        special="cancel"
                        class="btn-secondary"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
    <!-- Action for Room Reservation Summary -->
    <record id="action_hotel_reservation_summary" model="ir.actions.act_window">
        <field name="name">Reservation Summary</field>
        <field name="res_model">room.reservation.summary</field>
        <field name="view_mode">form</field>
    </record>
    <menuitem
        id="menu_action_hotel_reservation_summary"
        name="Reservation Summary"
        action="action_hotel_reservation_summary"
        parent="menu_hotel_reservation"
        sequence="3"
    />
</odoo>
