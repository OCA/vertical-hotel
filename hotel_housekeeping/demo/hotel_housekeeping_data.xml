<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!--Demo data for hotel housekeeping activity type -->
    <record
        id="hotel_housekeeping_activity_type_0"
        model="hotel.housekeeping.activity.type"
    >
        <field name="name">All Activities</field>
    </record>

    <record
        id="hotel_housekeeping_activity_type_1"
        model="hotel.housekeeping.activity.type"
    >
        <field name="parent_id" ref="hotel_housekeeping_activity_type_0" />
        <field name="name">Room Activity</field>
    </record>

    <record
        id="hotel_housekeeping_activity_type_2"
        model="hotel.housekeeping.activity.type"
    >
        <field name="parent_id" ref="hotel_housekeeping_activity_type_0" />
        <field name="name">Bed Activity</field>
    </record>

    <!--Demo data for hotel housekeeping activities -->
    <record id="hotel_room_activities_1" model="hotel.activity">
        <field name="name">Room Cleaning</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_1" />
    </record>

    <record id="hotel_room_activities_2" model="hotel.activity">
        <field name="name">Food Delivery</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_0" />
    </record>

    <record id="hotel_room_activities_3" model="hotel.activity">
        <field name="name">Vacuuming</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_0" />
    </record>

    <record id="hotel_room_activities_4" model="hotel.activity">
        <field name="name">Finishing Touches</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_0" />
    </record>

    <record id="hotel_room_activities_5" model="hotel.activity">
        <field name="name">Stripping the Room</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_1" />
    </record>

    <record id="hotel_room_activities_6" model="hotel.activity">
        <field name="name">Making the Beds</field>
        <field name="categ_id" ref="hotel_housekeeping_activity_type_2" />
    </record>

    <!--Demo housekeeping jobs -->
    <record id="hotel_housekeeping_demo_1" model="hotel.housekeeping">
        <field name="room_id" ref="vertical_hotel.hotel_room_0" />
        <field name="clean_type">checkout</field>
        <field name="inspector_id" ref="base.user_admin" />
    </record>

    <record id="hotel_housekeeping_demo_2" model="hotel.housekeeping">
        <field name="room_id" ref="vertical_hotel.hotel_room_1" />
        <field name="clean_type">daily</field>
        <field name="inspector_id" ref="base.user_admin" />
        <field
            name="activity_line_ids"
            eval="[
                Command.create({
                    'activity_id': ref('hotel_room_activities_1'),
                    'housekeeper_id': ref('base.user_demo'),
                    'clean_start_time': (DateTime.today() - relativedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S'),
                    'clean_end_time': (DateTime.today() - relativedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S'),
                }),
                Command.create({
                    'activity_id': ref('hotel_room_activities_6'),
                    'housekeeper_id': ref('base.user_demo'),
                    'clean_start_time': (DateTime.today() - relativedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S'),
                    'clean_end_time': (DateTime.today() - relativedelta(hours=1, minutes=30)).strftime('%Y-%m-%d %H:%M:%S'),
                }),
            ]"
        />
    </record>
    <function model="hotel.housekeeping" name="room_clean">
        <value eval="[ref('hotel_housekeeping_demo_2')]" />
    </function>
</odoo>
