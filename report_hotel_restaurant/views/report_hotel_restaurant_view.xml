<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view of the restaurant sales analysis -->
    <record id="view_hotel_restaurant_status_tree" model="ir.ui.view">
        <field name="name">report.hotel.restaurant.status.list</field>
        <field name="model">report.hotel.restaurant.status</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_date" />
                <field name="order_number" />
                <field name="order_kind" optional="show" />
                <field name="customer_id" />
                <field name="waiter_id" optional="hide" />
                <field name="folio_id" optional="hide" />
                <field name="menucard_id" />
                <field name="menu_categ_id" optional="show" />
                <field name="quantity" sum="Quantity" />
                <field name="amount" sum="Amount" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'order'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'cancel'"
                />
            </list>
        </field>
    </record>

    <!-- Form view of the restaurant sales analysis -->
    <record id="view_hotel_restaurant_status_form" model="ir.ui.view">
        <field name="name">report.hotel.restaurant.status.form</field>
        <field name="model">report.hotel.restaurant.status</field>
        <field name="arch" type="xml">
            <form string="Restaurant Sales Analysis">
                <sheet>
                    <group>
                        <group>
                            <field name="order_number" />
                            <field name="order_kind" />
                            <field name="order_date" />
                            <field name="reservation_id" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="customer_id" />
                            <field name="waiter_id" />
                            <field name="is_folio" />
                            <field name="folio_id" />
                            <field name="menucard_id" />
                            <field name="menu_categ_id" />
                            <field name="quantity" />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view of the restaurant sales analysis -->
    <record id="report_hotel_restaurant_status_search" model="ir.ui.view">
        <field name="name">report.hotel.restaurant.status.search</field>
        <field name="model">report.hotel.restaurant.status</field>
        <field name="arch" type="xml">
            <search string="Restaurant Sales Analysis">
                <field name="order_number" />
                <field name="customer_id" />
                <field name="waiter_id" />
                <field name="menucard_id" />
                <field name="menu_categ_id" />
                <field name="folio_id" />
                <filter
                    name="table_orders"
                    string="Table Orders"
                    domain="[('order_kind', '=', 'table')]"
                />
                <filter
                    name="booking_orders"
                    string="Booking Orders"
                    domain="[('order_kind', '=', 'booking')]"
                />
                <separator />
                <filter
                    name="hotel_guests"
                    string="Hotel Guests"
                    domain="[('is_folio', '=', True)]"
                />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="order"
                    string="Order Created"
                    domain="[('state', '=', 'order')]"
                />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <filter
                    name="cancel"
                    string="Cancelled"
                    domain="[('state', '=', 'cancel')]"
                />
                <filter
                    name="not_cancelled"
                    string="Not Cancelled"
                    domain="[('state', '!=', 'cancel')]"
                />
                <separator />
                <filter name="filter_order_date" string="Date" date="order_date" />
                <group>
                    <filter
                        name="groupby_category"
                        string="Food Item Category"
                        context="{'group_by': 'menu_categ_id'}"
                    />
                    <filter
                        name="groupby_item"
                        string="Food Item"
                        context="{'group_by': 'menucard_id'}"
                    />
                    <filter
                        name="groupby_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"
                    />
                    <filter
                        name="groupby_waiter"
                        string="Waiter"
                        context="{'group_by': 'waiter_id'}"
                    />
                    <filter
                        name="groupby_kind"
                        string="Order Kind"
                        context="{'group_by': 'order_kind'}"
                    />
                    <filter
                        name="groupby_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="groupby_month"
                        string="Month"
                        context="{'group_by': 'order_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot view of the restaurant sales analysis -->
    <record id="view_hotel_restaurant_status_pivot" model="ir.ui.view">
        <field name="name">report.hotel.restaurant.status.pivot</field>
        <field name="model">report.hotel.restaurant.status</field>
        <field name="arch" type="xml">
            <pivot string="Restaurant Sales Analysis" sample="1">
                <field name="order_date" interval="month" type="row" />
                <field name="menu_categ_id" type="col" />
                <field name="quantity" type="measure" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graph view of the restaurant sales analysis -->
    <record id="view_hotel_restaurant_status_graph" model="ir.ui.view">
        <field name="name">report.hotel.restaurant.status.graph</field>
        <field name="model">report.hotel.restaurant.status</field>
        <field name="arch" type="xml">
            <graph string="Restaurant Sales Analysis" type="bar" sample="1">
                <field name="order_date" interval="month" />
                <field name="amount" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Action of the restaurant sales analysis -->
    <record id="action_report_hotel_restaurant_status" model="ir.actions.act_window">
        <field name="name">Restaurant Sales Analysis</field>
        <field name="res_model">report.hotel.restaurant.status</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No restaurant order yet</p>
            <p>Food items sold by the restaurant, by month, category, customer
                and waiter.</p>
        </field>
    </record>

    <menuitem
        id="menu_report_hotel_restaurant_status"
        name="Restaurant Sales Analysis"
        action="action_report_hotel_restaurant_status"
        sequence="35"
        parent="report_hotel_reservation.menu_hotel_reporting"
    />
</odoo>
